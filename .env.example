# CloudGuard Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ─── Application ─────────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=true
SECRET_KEY=CHANGE_ME_USE_A_LONG_RANDOM_STRING_HERE
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── Database ────────────────────────────────────────────────────────────────
# SQLite (default for local dev - no setup needed)
DATABASE_URL=sqlite+aiosqlite:///./cloudguard.db

# PostgreSQL (uncomment when Docker/Postgres is available)
# DATABASE_URL=postgresql+asyncpg://cloudguard:CHANGE_ME@localhost:5432/cloudguard

# ─── Redis (optional - for event queuing, Stage 8+) ───────────────────────────
# REDIS_URL=redis://localhost:6379/0

# ─── Security ────────────────────────────────────────────────────────────────
# Default admin credentials (change before any real deployment)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=CHANGE_ME

# ─── Detection Settings ──────────────────────────────────────────────────────
# Set to false in production to require manual approval before response actions
AUTOMATED_RESPONSE_ENABLED=false
DEMO_MODE_ENABLED=true

# ─── CORS ────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── Telemetry ───────────────────────────────────────────────────────────────
# Use simulated telemetry when real runtime monitoring (Falco/eBPF) is unavailable
USE_SIMULATED_TELEMETRY=true
TELEMETRY_INTERVAL_SECONDS=5
